  "securityDefinitions" : {
    "Basic" : {
      "description" : "API Gateway Administrator and API Gateway provider",
      "type" : "basic"
    }
  },
  "definitions" : {
    "CryptoRepositoryConfig" : {
      "type" : "object",
      "properties" : {
        "alias" : {
          "type" : "string",
          "description" : "Alias name in Keystore/Truststore file to be used for connecting to target datastore."
        },
        "filePath" : {
          "type" : "string",
          "description" : "Filepath for the target datastore's Keystore/Truststore.It's important to verify it is in jks format."
        },
        "password" : {
          "type" : "string",
          "description" : "The password for the keystore/Truststore for the target datastore"
        },
        "value" : {
          "type" : "string",
          "description" : "Base64 encoded keystore/truststore of the target datastore."
        }
      }
    },
    "DashboardConfigDetails" : {
      "type" : "object",
      "properties" : {
        "endpoint" : {
          "type" : "string",
          "description" : "Endpoint of the target DataStore"
        },
        "userName" : {
          "type" : "string",
          "description" : "Username of the target DataStore"
        }
      }
    },
    "EndpointConfigDetails" : {
      "type" : "object",
      "properties" : {
        "basepath" : {
          "type" : "string",
          "description" : "Basepath of the target DataStore endpoint"
        },
        "endpoint" : {
          "type" : "string",
          "description" : "Endpoint of the target DataStore"
        },
        "keystore" : {
          "$ref" : "#/definitions/CryptoRepositoryConfig"
        },
        "password" : {
          "type" : "string",
          "description" : "Password of the target datatstore"
        },
        "truststore" : {
          "$ref" : "#/definitions/CryptoRepositoryConfig"
        },
        "userName" : {
          "type" : "string",
          "description" : "Username of the target DataStore"
        }
      }
    },
    "MigrateDatacopyCoreRequest" : {
      "type" : "object",
      "properties" : {
        "targetCoreEndpointConfig" : {
          "$ref" : "#/definitions/EndpointConfigDetails"
        },
        "webhookConfig" : {
          "$ref" : "#/definitions/WebhookConfigDetails"
        }
      }
    },
    "MigrateDatacopyEventsAndLogsRequest" : {
      "type" : "object",
      "properties" : {
        "targetDashboardConfig" : {
          "$ref" : "#/definitions/DashboardConfigDetails"
        },
        "targetEventsLogsEndpointConfig" : {
          "$ref" : "#/definitions/EndpointConfigDetails"
        },
        "webhookConfig" : {
          "$ref" : "#/definitions/WebhookConfigDetails"
        }
      }
    },
    "MigrateDatacopyRequest" : {
      "type" : "object",
      "properties" : {
        "targetCoreEndpointConfig" : {
          "$ref" : "#/definitions/EndpointConfigDetails"
        },
        "targetDashboardConfig" : {
          "$ref" : "#/definitions/DashboardConfigDetails"
        },
        "targetEventsLogsEndpointConfig" : {
          "$ref" : "#/definitions/EndpointConfigDetails"
        },
        "webhookConfig" : {
          "$ref" : "#/definitions/WebhookConfigDetails"
        }
      }
    },
    "MigrateDatacopyStatusResponse" : {
      "type" : "object",
      "properties" : {
        "datacopyStatus" : {
          "type" : "array",
          "description" : "status of the migration process workflow execution",
          "items" : {
            "$ref" : "#/definitions/MigrationWorkFlowContext"
          }
        }
      }
    },
    "MigrationWorkFlowContext" : {
      "type" : "object",
      "properties" : {
        "inputConfig" : {
          "type" : "object",
          "additionalProperties" : {
            "type" : "string"
          }
        },
        "outData" : {
          "type" : "object",
          "additionalProperties" : {
            "type" : "string"
          }
        },
        "subWorkFlowContext" : {
          "type" : "array",
          "items" : {
            "$ref" : "#/definitions/MigrationWorkFlowContext"
          }
        },
        "taskLogs" : {
          "type" : "array",
          "items" : {
            "$ref" : "#/definitions/TaskLog"
          }
        },
        "workFlow" : {
          "type" : "string",
          "enum" : [ "CORE_SOURCE", "CORE_TARGET", "EVENTS_AND_LOGS_SOURCE", "EVENTS_AND_LOGS_TARGET", "ROLLBACK_SOURCE", "ROLLBACK_TARGET", "DATACOPY_CORE", "DATACOPY_EVENTSANDLOGS", "DATACOPY_ROLLBACK", "DATACOPY_CORE_WITHOUT_SWITCH", "DATACOPY_EVENTSANDLOGS_WITHOUT_SWITCH", "IMPORT_DATA", "RESTORE_REINDEX_SWITCH", "RESTORE_REINDEX_SWITCH_01", "RESTORE_REINDEX_SWITCH_02", "RESTORE_REINDEX_SWITCH_03", "RESTORE_REINDEX_SWITCH_04", "RESTORE_REINDEX_SWITCH_05", "RESTORE_REINDEX_SWITCH_06" ]
        },
        "workFlowState" : {
          "type" : "string",
          "enum" : [ "INPROGRESS", "SUCCESS", "FAILURE", "PARTIAL" ]
        }
      }
    },
    "TaskLog" : {
      "type" : "object",
      "properties" : {
        "endTime" : {
          "type" : "string"
        },
        "logs" : {
          "type" : "array",
          "items" : {
            "type" : "string"
          }
        },
        "startTime" : {
          "type" : "string"
        },
        "state" : {
          "type" : "string",
          "enum" : [ "INPROGRESS", "SUCCESS", "FAILURE", "PARTIAL" ]
        },
        "taskName" : {
          "type" : "string"
        }
      }
    },
    "WebhookConfigDetails" : {
      "type" : "object",
      "properties" : {
        "endpoint" : {
          "type" : "string",
          "description" : "Endpoint of the target DataStore"
        },
        "password" : {
          "type" : "string",
          "description" : "Password of the target DataStore"
        },
        "template" : {
          "type" : "string",
          "description" : "webhook payload template to be posted to webhook endpoint.Available variables to be used in the template are @@status@@, @@workflow@@ and @@log@@ "
        },
        "userName" : {
          "type" : "string",
          "description" : "Username of the target DataStore"
        }
      }
    }
  }
}
